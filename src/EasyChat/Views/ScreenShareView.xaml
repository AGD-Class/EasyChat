<Window x:Class="EasyChat.Views.ScreenShareView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕共享"
        Height="540"
        Width="840"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#111111"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Background="#111111">
        <Image x:Name="ScreenImage"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               Focusable="True"
               MouseDown="ScreenImage_MouseDown"
               MouseMove="ScreenImage_MouseMove"
               MouseUp="ScreenImage_MouseUp"
               MouseWheel="ScreenImage_MouseWheel" />

        <Border x:Name="StatusBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                Padding="12,8"
                CornerRadius="6"
                Background="#CC000000">
            <TextBlock x:Name="StatusText"
                       Text="正在连接屏幕共享..."
                       Foreground="White"
                       FontSize="14" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="16">
            <Button x:Name="ControlButton"
                    Content="请求控制"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Click="ControlButton_Click" />
            <Button Content="关闭"
                    Padding="14,6"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
