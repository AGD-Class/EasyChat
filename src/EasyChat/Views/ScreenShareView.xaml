<Window x:Class="EasyChat.Views.ScreenShareView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕共享"
        Height="540"
        Width="840"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#111111"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
    </Window.Resources>
    <Grid Background="#111111">
        <Image x:Name="ScreenImage"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               Focusable="True"
               MouseDown="ScreenImage_MouseDown"
               MouseMove="ScreenImage_MouseMove"
               MouseUp="ScreenImage_MouseUp"
               MouseWheel="ScreenImage_MouseWheel" />

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,14,0,0"
                Padding="10"
                CornerRadius="8"
                Background="#EE111827"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="屏幕共享"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button x:Name="ControlButton"
                        Style="{StaticResource ToolbarButton}"
                        Content="请求控制"
                        Margin="0,0,0,0"
                        ToolTip="向对方申请远程控制"
                        Click="ControlButton_Click" />
                <Button Content="关闭"
                        Style="{StaticResource ToolbarButton}"
                        Margin="8,0,0,0"
                        ToolTip="关闭屏幕共享窗口"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="StatusBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16"
                Padding="12,8"
                CornerRadius="6"
                Background="#CC000000">
            <TextBlock x:Name="StatusText"
                       Text="正在连接屏幕共享..."
                       Foreground="White"
                       FontSize="14" />
        </Border>
    </Grid>
</Window>
