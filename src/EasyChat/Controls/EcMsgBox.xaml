<Window x:Class="EasyChat.Controls.EcMsgBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="150" Width="260" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Border Background="White" CornerRadius="10" BorderBrush="Pink" BorderThickness="2" Padding="20">
            <StackPanel>
                <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" FontSize="16" Foreground="Pink"
                           TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button x:Name="OkButton" Content="好(*╹▽╹*)~" Width="88" Height="30"
                            Background="Pink" Foreground="White" Click="OkButton_Click" />
                    <Button x:Name="CancelButton" Content="取消" Width="88" Height="30" Margin="8,0,0,0"
                            Background="White" Foreground="Pink" BorderBrush="Pink" Click="CancelButton_Click"
                            Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
